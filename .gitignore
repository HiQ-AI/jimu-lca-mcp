# Node / TS build artefacts
node_modules/
dist/
build/
*.tsbuildinfo
*.tgz
.pnpm-store/
.npm/

# Wrangler / Cloudflare Worker local state + build cache
.wrangler/
.dev.vars

# Env / secrets
.env
.env.*
!.env.example

# Local secret files — memberKey lives in env vars / OS keychain, not on disk
*.key
secrets/

# Test scaffolding stays local — never publish (fixtures may carry customer data)
tests/

# Binding-bridge artifacts — the 积木 mapping exports and the generated D1 dump
# are operator inputs/outputs, loaded into D1 out of band (docs/architecture/local-bridge.md)
*.xlsx
bridge.sql

# Local CLI/session state (carries working space + case ids)
jimu-lca-session.json

# Python (docs tooling — scripts/render_endpoint_docs.py)
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# macOS
.DS_Store

# Editor metadata
.vscode/
.idea/
