# Node / TS build artefacts
node_modules/
dist/
build/
*.tsbuildinfo
*.tgz
.pnpm-store/
.npm/

# Wrangler / Cloudflare Worker local state + build cache
.wrangler/
.dev.vars

# Env / secrets
.env
.env.*
!.env.example

# Local secret files — memberKey lives in env vars / OS keychain, not on disk
*.key
secrets/

# Test scaffolding stays local — never publish (fixtures may carry customer data)
tests/

# Binding-bridge artifacts — the 积木 mapping exports, the generated D1 dump, and
# the built SQLite db (+ its gzip) are operator inputs/outputs. They are loaded
# into D1 / attached to a GitHub Release out of band, never committed
# (docs/architecture/local-bridge.md).
*.xlsx
bridge.sql
bridge.db
bridge.db.gz

# Local CLI/session state (carries working space + case ids)
jimu-lca-session.json

# Python (docs tooling — scripts/render_endpoint_docs.py)
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# macOS
.DS_Store

# Editor metadata
.vscode/
.idea/
